{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brand-ai-readiness-audit.dev/audit-report.schema.json",
  "title": "AuditReport",
  "description": "The authoritative floor schema for a Brand AI Readiness Audit final report. Every audit run MUST emit an object validating against this schema, produced by the freshness-corroboration skill.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "site",
    "audited_at",
    "summary",
    "findings"
  ],
  "properties": {
    "site": {
      "type": "string",
      "minLength": 1,
      "description": "The audited domain, e.g. 'example.com'."
    },
    "audited_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of when the audit was run."
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "total_findings",
        "critical",
        "high",
        "medium"
      ],
      "properties": {
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "readiness_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "by_axis": {
          "type": "object"
        },
        "score_formula": {
          "type": "string"
        },
        "headline": {
          "type": "string",
          "description": "One sentence a non-expert can act on, stating what was checked as well as what was found."
        },
        "top_priorities": {
          "type": "array",
          "maxItems": 5,
          "description": "The few highest-impact items to start with. A pointer into findings/opportunities, never a replacement for them.",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "priority",
              "summary",
              "type"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "description": "The F-00n or O-00n entry this points at."
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "finding",
                  "opportunity"
                ]
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "meta": {
      "type": "object",
      "description": "Optional meta-analysis block: ontology coverage measurement and structural validation of the findings/summary above. Additive \u2014 a report without it (e.g. from an older producer) still validates.",
      "additionalProperties": true,
      "properties": {
        "coverage": {
          "type": "object",
          "description": "Which ontology failure modes could actually be evaluated this run, per category, given which skills/backends were engaged.",
          "additionalProperties": true,
          "properties": {
            "ontology_version": {
              "type": "string"
            },
            "skills_engaged": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "overall_coverage_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "categories": {
              "type": "object"
            }
          }
        },
        "validation": {
          "type": "object",
          "description": "Structural self-checks on this report (no duplicate/out-of-order ids, summary counts match the findings array, etc.) plus informational cross-finding correlation notes.",
          "additionalProperties": true,
          "required": [
            "passed",
            "checks"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "passed"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "passed": {
                    "type": "boolean"
                  },
                  "means": {
                    "type": "string"
                  }
                }
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "crawl": {
          "type": "object",
          "description": "What the crawl actually covered. `stopped_early` is true when a budget cut it short, so a partial crawl is never mistaken for a complete one.",
          "properties": {
            "pages_crawled": {
              "type": "integer",
              "minimum": 0
            },
            "pages_unreachable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stopped_early": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "audit_limitations": {
      "type": "array",
      "description": "Checks this audit could not complete \u2014 a missing render backend, an exhausted budget. These describe the audit, not the site: they never appear in findings and never affect the readiness score.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "detail"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string"
          },
          "affected_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "schema_version": {
      "type": "string",
      "description": "Version of this report's top-level shape."
    },
    "site_info": {
      "type": "object",
      "description": "Richer detail about what was audited. `site` and `audited_at` remain top-level scalars because the floor schema requires them there.",
      "properties": {
        "domain": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "opportunities": {
      "type": "array",
      "description": "Proactive recommendations that apply whether or not a defect was found. Deliberately separate from `findings`: these carry no evidence and never affect the readiness score.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^O-[0-9]{3,}$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "axis": {
            "type": "string",
            "enum": [
              "visibility",
              "staleness",
              "engagement",
              "identity"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "severity",
        "evidence",
        "suggested_action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3,}$",
          "description": "Sequential finding identifier, e.g. F-001."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Exact title from the Failure Ontology (audit_finding_title)."
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete observed metrics, not a restatement of the signal name."
        },
        "suggested_action": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "summary",
            "priority"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "priority": {
              "type": "string",
              "enum": [
                "critical",
                "high",
                "medium",
                "low"
              ]
            }
          }
        },
        "axis": {
          "type": "string",
          "enum": [
            "visibility",
            "staleness",
            "engagement",
            "identity"
          ],
          "description": "Which brand-facing problem this finding belongs to."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "How well the sample supports this finding, separate from severity. Severity is how bad the problem is; confidence is how sure we are it is real and site-wide. 'high' means observed on every page crawled (with a meaningful sample) or directly observed as a policy fact; 'low' means seen on a minority of pages."
        }
      }
    }
  }
}
