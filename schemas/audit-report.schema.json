{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brand-ai-readiness-audit.dev/audit-report.schema.json",
  "title": "AuditReport",
  "description": "The authoritative floor schema for a Brand AI Readiness Audit final report. Every audit run MUST emit an object validating against this schema, produced by the freshness-corroboration skill.",
  "type": "object",
  "additionalProperties": true,
  "required": ["site", "audited_at", "summary", "findings"],
  "properties": {
    "site": {
      "type": "string",
      "minLength": 1,
      "description": "The audited domain, e.g. 'example.com'."
    },
    "audited_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of when the audit was run."
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total_findings", "critical", "high", "medium"],
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "meta": {
      "type": "object",
      "description": "Optional meta-analysis block: ontology coverage measurement and structural validation of the findings/summary above. Additive — a report without it (e.g. from an older producer) still validates.",
      "additionalProperties": true,
      "properties": {
        "coverage": {
          "type": "object",
          "description": "Which ontology failure modes could actually be evaluated this run, per category, given which skills/backends were engaged.",
          "additionalProperties": true,
          "properties": {
            "ontology_version": { "type": "string" },
            "skills_engaged": { "type": "array", "items": { "type": "string" } },
            "overall_coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "categories": { "type": "object" }
          }
        },
        "validation": {
          "type": "object",
          "description": "Structural self-checks on this report (no duplicate/out-of-order ids, summary counts match the findings array, etc.) plus informational cross-finding correlation notes.",
          "additionalProperties": true,
          "required": ["passed", "checks"],
          "properties": {
            "passed": { "type": "boolean" },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "passed"],
                "properties": {
                  "name": { "type": "string" },
                  "passed": { "type": "boolean" },
                  "means": { "type": "string" }
                }
              }
            },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "severity", "evidence", "suggested_action"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3,}$",
          "description": "Sequential finding identifier, e.g. F-001."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Exact title from the Failure Ontology (audit_finding_title)."
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete observed metrics, not a restatement of the signal name."
        },
        "suggested_action": {
          "type": "object",
          "additionalProperties": true,
          "required": ["summary", "priority"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "priority": {
              "type": "string",
              "enum": ["critical", "high", "medium", "low"]
            }
          }
        }
      }
    }
  }
}
