{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brand-ai-readiness-audit.dev/marketplace.schema.json",
  "title": "SkillMarketplaceManifest",
  "description": "Validates marketplace.json against the Round-3 submission rules: every skill is a folder, and exactly one is the entrypoint.",
  "type": "object",
  "required": [
    "name",
    "version",
    "skills"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^skills/[a-z0-9-]+$"
          },
          "summary": {
            "type": "string"
          },
          "entrypoint": {
            "const": true
          }
        }
      }
    }
  }
}
