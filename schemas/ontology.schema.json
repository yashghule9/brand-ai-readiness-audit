{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brand-ai-readiness-audit.dev/ontology.schema.json",
  "title": "WebFailureOntology",
  "description": "Meta-schema validating skills/failure-diagnostics/references/ontology.yaml. CI runs this on every change to the knowledge base.",
  "type": "object",
  "required": ["ontology_version", "categories", "failure_modes"],
  "properties": {
    "ontology_version": { "type": "string" },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "description"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "failure_modes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/failureMode" }
    }
  },
  "$defs": {
    "failureMode": {
      "type": "object",
      "required": [
        "category",
        "severity",
        "signals",
        "description",
        "recovery_strategy",
        "recommended_tool",
        "audit_finding_title"
      ],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "match_mode": {
          "type": "string",
          "enum": ["all", "any"],
          "default": "all",
          "description": "'all': every listed signal must be present. 'any': a single listed signal is sufficient. Defaults to 'all' when omitted."
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        },
        "description": { "type": "string", "minLength": 1 },
        "recovery_strategy": { "type": "string", "minLength": 1 },
        "recommended_tool": { "type": "string", "minLength": 1 },
        "audit_finding_title": { "type": "string", "minLength": 1 }
      }
    }
  }
}
